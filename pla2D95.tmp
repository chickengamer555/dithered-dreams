[sub_resource type="GDScript" id="GDScript_imhw4"]
script/source = "extends CharacterBody3D

@export var speed : float = 5.0
@export var jump_velocity : float = 5.0

@onready var camera = $Camera3D

func _ready():
    # Ensures the script runs when the game starts
    pass

func _physics_process(delta: float) -> void:
    # Input for movement
    var direction = Vector3.ZERO
    if Input.is_action_pressed(\"move_forward\"):
        direction -= camera.global_transform.basis.z
    if Input.is_action_pressed(\"move_backward\"):
        direction += camera.global_transform.basis.z
    if Input.is_action_pressed(\"move_left\"):
        direction -= camera.global_transform.basis.x
    if Input.is_action_pressed(\"move_right\"):
        direction += camera.global_transform.basis.x

    # Normalize direction and apply movement speed
    direction = direction.normalized() * speed

    # Apply gravity
    if not is_on_floor():
        velocity.y += ProjectSettings.get_setting(\"physics/3d/default_gravity\") * delta
    else:
        # Jump input
        if Input.is_action_just_pressed(\"jump\"):
            velocity.y = jump_velocity

    # Combine direction with current velocity
    velocity.x = direction.x
    velocity.z = direction.z

    # Move the player
    move_and_slide()

# You need to map your input actions in the Input Map in Project Settings.
# Use \"move_forward\", \"move_backward\", \"move_left\", \"move_right\" for movement and \"jump\" for jumping.
"

